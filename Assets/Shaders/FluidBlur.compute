#pragma kernel BlurHorizontal
#pragma kernel BlurVertical

Texture2D<float> Input;
RWTexture2D<float> Output;
cbuffer ScreenData
{
    int2 resolution;
};

// Better Gaussian weights
static const float w[7] = 
{
    0.275f,  // Center
    0.185f,  // ±1
    0.105f,  // ±2
    0.045f,  // ±3
    0.018f,  // ±4
    0.005f,  // ±5
    0.001f   // ±6
};

float SampleSafe(Texture2D<float> tex, int2 uv)
{
    uv = clamp(uv, int2(0,0), resolution - 1);
    return tex[uv];
}

[numthreads(8,8,1)]
void BlurHorizontal(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= resolution.x || id.y >= resolution.y) return;

    int2 uv = id.xy;
    float sum = 0;

    [unroll]
    for (int i = -6; i <= 6; i++)
    {
        int index = abs(i);
        sum += SampleSafe(Input, uv + int2(i, 0)) * w[index];
    }

    Output[uv] = sum;
}

[numthreads(8,8,1)]
void BlurVertical(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= resolution.x || id.y >= resolution.y) return;

    int2 uv = id.xy;
    float sum = 0;

    [unroll]
    for (int i = -6; i <= 6; i++)
    {
        int index = abs(i);
        sum += SampleSafe(Input, uv + int2(0, i)) * w[index];
    }

    Output[uv] = sum;
}