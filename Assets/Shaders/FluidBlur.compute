#pragma kernel BlurHorizontal
#pragma kernel BlurVertical

Texture2D<float4> Input;
RWTexture2D<float4> Output;

cbuffer ScreenData
{
    int2 resolution;
    float depthSigma;
    int radius;
};

float2 SampleSafe(Texture2D<float4> tex, int2 uv)
{
    uv = clamp(uv, int2(0, 0), resolution - 1);
    return tex[uv].rg;
}

float GaussianWeight(int offset, float sigma)
{
    return exp(-(offset * offset) / (2.0f * sigma * sigma));
}

[numthreads(8, 8, 1)]
void BlurHorizontal(uint3 id : SV_DispatchThreadID)
{
    int2 uv = int2(id.xy);
    if (uv.x >= resolution.x || uv.y >= resolution.y) return;

    int sampleRadius = clamp(radius, 1, 32);
    float sigma = max(depthSigma, 0.001f);
    float2 sum = 0.0f;
    float weightSum = 0.0f;

    for (int i = -sampleRadius; i <= sampleRadius; i++)
    {
        float weight = GaussianWeight(i, sigma);
        sum += SampleSafe(Input, uv + int2(i, 0)) * weight;
        weightSum += weight;
    }

    float2 blurred = sum / max(weightSum, 0.0001f);
    Output[uv] = float4(blurred, 0.0f, 0.0f);
}

[numthreads(8, 8, 1)]
void BlurVertical(uint3 id : SV_DispatchThreadID)
{
    int2 uv = int2(id.xy);
    if (uv.x >= resolution.x || uv.y >= resolution.y) return;

    int sampleRadius = clamp(radius, 1, 32);
    float sigma = max(depthSigma, 0.001f);
    float2 sum = 0.0f;
    float weightSum = 0.0f;

    for (int i = -sampleRadius; i <= sampleRadius; i++)
    {
        float weight = GaussianWeight(i, sigma);
        sum += SampleSafe(Input, uv + int2(0, i)) * weight;
        weightSum += weight;
    }

    float2 blurred = sum / max(weightSum, 0.0001f);
    Output[uv] = float4(blurred, 0.0f, 0.0f);
}
