#pragma kernel ApplyPlaneMotion
#pragma kernel ResolvePlaneCollision

#include "SurfaceCollision.hlsl"

RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<int> ParticleState;

uint numParticles;
float deltaTime;
float paintViscosity;

float3 planePosition;
float3 planeNormal;
float3 planeRight;
float3 planeUp;
float3 planeForward;
float3 previousPlanePosition;
float3 previousPlaneRight;
float3 previousPlaneUp;
float3 previousPlaneForward;

float planeRestitution;
float planeStaticFriction;
float planeDynamicFriction;
float planeSpread;
float planeAbsorption;

float surfaceWetness;
float wetnessSlideFactor;
float stopSpeedThreshold;
float3 gravityWorld;

float3 WorldToPreviousPlanePoint(float3 worldPoint)
{
    float3 offset = worldPoint - previousPlanePosition;
    return float3(
        dot(offset, previousPlaneRight),
        dot(offset, previousPlaneUp),
        dot(offset, previousPlaneForward));
}

float3 PlaneToWorldPoint(float3 localPoint)
{
    return planePosition +
        planeRight * localPoint.x +
        planeUp * localPoint.y +
        planeForward * localPoint.z;
}

[numthreads(64, 1, 1)]
void ApplyPlaneMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;

    int state = ParticleState[id.x];
    if (state != 1)
        return;

    float3 worldPos = Positions[id.x];
    float3 previousLocalPos = WorldToPreviousPlanePoint(worldPos);
    float3 carriedWorldPos = PlaneToWorldPoint(previousLocalPos);

    Positions[id.x] = carriedWorldPos;

    if (deltaTime > 0.00001)
    {
        float3 carriedVelocity = (carriedWorldPos - worldPos) / deltaTime;
        Velocities[id.x] = carriedVelocity;
    }
}

[numthreads(64, 1, 1)]
void ResolvePlaneCollision(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;

    int state = ParticleState[id.x];
    if (state == 0)
        return;

    float3 position = Positions[id.x];
    float3 velocity = Velocities[id.x];
    bool slidePhase = (state == 1);

    SurfaceCollisionResult result = ResolveSurfacePlaneCollision(
        position,
        velocity,
        planePosition,
        planeNormal,
        planeRestitution,
        planeStaticFriction,
        planeDynamicFriction,
        planeSpread,
        planeAbsorption,
        surfaceWetness,
        wetnessSlideFactor,
        paintViscosity,
        stopSpeedThreshold,
        deltaTime,
        gravityWorld,
        id.x,
        slidePhase);

    if (!result.hadContact)
        return;

    Positions[id.x] = result.position;
    Velocities[id.x] = result.velocity;

    float3 n = SurfaceSafeNormalize(planeNormal, float3(0, 1, 0));
    float normalOutSpeed = dot(result.velocity, n);

    if (result.shouldFreeze)
    {
        ParticleState[id.x] = 1;
    }
    else if (state == 2)
    {
        ParticleState[id.x] = normalOutSpeed > stopSpeedThreshold ? 2 : 1;
    }
}
