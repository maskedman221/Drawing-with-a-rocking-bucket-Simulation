#pragma kernel CSMain

Texture2D<float> Thickness;
RWTexture2D<float4> Normals;

cbuffer ScreenData
{
    int2 resolution;
}

float Sample(int2 uv)
{
    uv = clamp(uv, int2(0,0), resolution - 1);
    return Thickness[uv];
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= resolution.x || id.y >= resolution.y) return;

    int2 uv = id.xy;
    
    // Sample surrounding pixels with proper offsets
    float center = Sample(uv);
    float L = Sample(uv + int2(-1, 0));
    float R = Sample(uv + int2( 1, 0));
    float D = Sample(uv + int2(0, -1));
    float U = Sample(uv + int2(0,  1));

    // Calculate gradients with proper scaling
    float dx = (R - L) * 0.5f;
    float dy = (U - D) * 0.5f;
    
    // Thickness-based normal strength
    float strength = smoothstep(0.01f, 0.1f, center);
    
    // Generate normal
    float3 normal = normalize(float3(-dx, -dy, 1.0f));
    
    // Blend with flat normal for thin areas
    float3 flatNormal = float3(0, 0, 1);
    normal = normalize(lerp(flatNormal, normal, strength));

    Normals[uv] = float4(normal * 0.5 + 0.5, 1);
}